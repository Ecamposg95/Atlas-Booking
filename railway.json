{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {"builder": "RAILPACK", "buildCommand": "cd frontend && npm ci && npm run build"},
  "deploy": {"startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT", "healthcheckPath": "/api/health", "restartPolicyType": "ON_FAILURE"}
}
